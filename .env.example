# Budget configuration. Copy to .env (repo root) and fill in. The API server
# and bin/migrate.dart read ./.env or ../.env (or $ENV_FILE); real process
# environment variables override the file.

# development | production. production hard-disables the dev bypass and
# requires SESSION_SECRET, GOOGLE_CLIENT_ID and an https PUBLIC_ORIGIN.
APP_ENV=development

# The browser origin of the site (CORS + CSRF Origin check, Secure cookies when https).
PUBLIC_ORIGIN=https://unsaid-generic-jubilance.ngrok-free.dev
# Extra allowed origins, comma separated (localhost:8000 is always allowed outside production).
CORS_ORIGINS=

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized JavaScript origins: the ngrok URL above, http://localhost:8000, http://localhost,
# and later https://<your domain>. No redirect URIs needed.
GOOGLE_CLIENT_ID=

# Admins (always allowed). The first one owns pre-existing data (migration 009).
ADMIN_EMAILS=musicartscience@gmail.com
# Who else may sign in: emails and/or @domain entries, comma separated.
# Empty = admins + people with a pending invite (+ allowed_emails table).
AUTH_ALLOWLIST=
AUTH_OPEN_SIGNUP=false
AUTH_INVITES_BYPASS_ALLOWLIST=true

# Dev only: POST /api/auth/dev-login (or open GET /api/auth/dev-login?redirect=/)
# signs in as the first ADMIN_EMAILS user. The server refuses to start with
# this on and APP_ENV=production.
AUTH_DEV_BYPASS=true

# HMAC key for session tokens. Generate: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_DAYS=30

DATABASE_URL=postgres://budget:budget@127.0.0.1:5432/budget
DB_POOL_SIZE=10
API_HOST=127.0.0.1
API_PORT=8080

# --- production compose (P6) ---
# SITE_DOMAIN=budget.example.com
# POSTGRES_PASSWORD=change-me
# API_REPLICAS=2

# --- hardening (P6c) ---
# TRUSTED_PROXIES=127.0.0.1,::1
# RATE_LIMIT_AUTH_PER_MIN=20
# RATE_LIMIT_PER_MIN=600
# SESSION_CACHE_TTL_SECONDS=10
# SHUTDOWN_GRACE_SECONDS=10
# CLEANUP_INTERVAL_MINUTES=60
