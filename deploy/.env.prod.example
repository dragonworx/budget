# Production settings for deploy/docker-compose.prod.yml. Copy to deploy/.env.prod
# (never commit it) and fill in. See docs/deploy.md.

APP_ENV=production
# Public hostname. Bundled Caddy gets a Let's Encrypt certificate for it.
SITE_DOMAIN=budget.example.com
PUBLIC_ORIGIN=https://budget.example.com
CORS_ORIGINS=

# Google Cloud OAuth client (Web application); add https://budget.example.com
# to its Authorized JavaScript origins.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

ADMIN_EMAILS=musicartscience@gmail.com
AUTH_ALLOWLIST=
AUTH_OPEN_SIGNUP=false
AUTH_INVITES_BYPASS_ALLOWLIST=true
# AUTH_DEV_BYPASS is forced to false by the compose file.

# openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_DAYS=30

# openssl rand -hex 24
POSTGRES_PASSWORD=
DB_POOL_SIZE=10
API_REPLICAS=2

# Ports for the bundled Caddy (defaults 80/443). Host-Caddy variant uses WEB_PORT.
# HTTP_PORT=80
# HTTPS_PORT=443
# WEB_PORT=8081
