# Bundled Caddy: TLS (automatic Let's Encrypt), static web app, API load balancing.
# SITE_ADDRESS: "budget.example.com" in production (TLS), ":80" behind a host Caddy
# or for local testing (plain HTTP).
{
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		# Google sign-in popup posts the credential back via window.opener.
		Cross-Origin-Opener-Policy same-origin-allow-popups
		# Google Identity Services needs accounts.google.com; CanvasKit + fonts come from gstatic.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob: https://accounts.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://accounts.google.com https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://accounts.google.com https://www.gstatic.com https://fonts.gstatic.com https://fonts.googleapis.com; frame-src https://accounts.google.com; worker-src 'self' blob:"
		-Server
	}

	@api path /api/* /health /ready
	handle @api {
		reverse_proxy {
			# Every api replica (Docker DNS returns one A record per replica).
			dynamic a api 8080 {
				refresh 5s
			}
			lb_policy round_robin
			lb_retries 2
			health_uri /ready
			health_interval 10s
			# Stream SSE (/api/events) immediately.
			flush_interval -1
		}
	}

	handle {
		root * /srv/web
		@immutable path /canvaskit/* *.wasm
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		# Flutter asset names are not content-hashed (brand SVGs, fonts,
		# manifests): revalidate each load (cheap 304s) so a new build's
		# assets show at once.
		@assets path /assets/*
		header @assets Cache-Control "no-cache"
		# Favicons / app icons / manifest: a day at most (index.html also
		# links them with ?v=, bumped when they change).
		@icons path /favicon.ico /favicon-32.png /apple-touch-icon-180.png /icons/* /manifest.json
		header @icons Cache-Control "public, max-age=86400"
		@html path / /index.html /flutter_bootstrap.js /flutter_service_worker.js /version.json /build.json /main.dart.js
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		# .br/.zst/.gz siblings are made at image build (client/Dockerfile);
		# anything without one falls back to `encode` above.
		file_server {
			precompressed br zstd gzip
		}
	}
}
