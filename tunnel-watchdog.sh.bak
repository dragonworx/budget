#!/usr/bin/env bash
# Dev env watchdog (tmux window budget:watchdog, started by dev.sh). Log: /workspace/dev-logs/watchdog.log
#
# Every FAST s (default 5, all local / free):
#  - tunnel window missing -> recreate it (it runs tunnel-run.sh, which restarts ngrok ~1s after any exit)
#  - ngrok agent API (127.0.0.1:4040/api/tunnels) has no https tunnel for >= AGENT_GRACE s -> kill ngrok
#    (the wrapper restarts it); new ngrok log errors (reconnects, heartbeat, session closed) are logged
#  - local proxy /health: refused -> respawn proxy; non-200 -> respawn api
# Every PUBLIC_EVERY s (default 150): one public /health request (~576/day of ngrok's request budget).
#   A failure while everything local is fine restarts ngrok immediately.
# Restarts of a target back off (20s, 40s, ... max 10 min) and reset once it is healthy.
set -uo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"; LOGS=/workspace/dev-logs; S=budget
PUBLIC=${PUBLIC_URL:-https://unsaid-generic-jubilance.ngrok-free.dev}
FAST=${FAST:-5}; PUBLIC_EVERY=${PUBLIC_EVERY:-150}; AGENT_GRACE=${AGENT_GRACE:-8}
export PATH="$HOME/flutter/bin:$PATH" DATABASE_URL=postgres://budget:budget@127.0.0.1:5432/budget API_HOST=127.0.0.1 API_PORT=8080
WEB_MODE=${WEB_MODE:-release}
log() { echo "$(date '+%F %T %Z') $*" >> $LOGS/watchdog.log; echo "$(date '+%T') $*"; }
declare -A CMD=(
  [tunnel]="$ROOT/tunnel-run.sh"
  [proxy]="WEB_MODE=$WEB_MODE node $ROOT/dev-proxy.js 2>&1 | tee $LOGS/proxy.log"
  [api]="cd $ROOT/server && while true; do dart run bin/server.dart & P=\$!; inotifywait -qq -r -e modify,create,delete,move lib bin; echo '--- change detected, restarting API'; kill \$P; wait \$P 2>/dev/null; done 2>&1 | tee $LOGS/api.log"
)
declare -A NEXT=() WAIT=()
can_restart() {  # backoff gate; $1 = target
  local w=$1 now; now=$(date +%s)
  if (( now < ${NEXT[$w]:-0} )); then return 1; fi
  local wait=${WAIT[$w]:-20}; NEXT[$w]=$(( now + wait )); WAIT[$w]=$(( wait * 2 > 600 ? 600 : wait * 2 ))
}
healthy() { unset "NEXT[$1]" "WAIT[$1]"; }
has_window() { tmux list-windows -t $S -F '#W' 2>/dev/null | grep -qx "$1"; }
respawn() {  # $1 = window
  if has_window "$1"; then tmux respawn-window -k -t "$S:$1" "${CMD[$1]}"
  else tmux new-window -d -t $S -n "$1" "${CMD[$1]}"; fi
}
restart_ngrok() {  # $1 = reason
  can_restart ngrok || { log "ngrok unhealthy ($1); restart backed off"; return; }
  if has_window tunnel && pgrep -f 'tunnel-run.sh' >/dev/null; then
    pkill -x ngrok; log "RESTARTED ngrok ($1)"   # wrapper brings it back in ~1s
  else
    pkill -x ngrok; respawn tunnel; log "RESTARTED tunnel window ($1)"
  fi
}
agent_ok() { curl -s -m 2 http://127.0.0.1:4040/api/tunnels | grep -q '"public_url":"https://'; }

log "watchdog started (fast ${FAST}s local checks, public every ${PUBLIC_EVERY}s)"
logpos=$(stat -c %s $LOGS/tunnel.log 2>/dev/null || echo 0)
agent_bad_since=0; last_public=0
while true; do
  now=$(date +%s)
  # 1. tunnel window / wrapper present
  if ! has_window tunnel || ! pgrep -f 'tunnel-run.sh' >/dev/null; then
    pkill -x ngrok; respawn tunnel; log "tunnel window/wrapper missing -> recreated"; agent_bad_since=0; sleep 3
  fi
  # 2. new ngrok log problems (diagnostics)
  size=$(stat -c %s $LOGS/tunnel.log 2>/dev/null || echo 0); (( size < logpos )) && logpos=0
  if (( size > logpos )); then
    tail -c +$((logpos + 1)) $LOGS/tunnel.log | head -c 200000 \
      | grep -E 'lvl=(eror|crit|warn)|heartbeat|reconnect|session closed|failed to|tunnel-run' \
      | grep -vE "can't bind default web address" \
      | sed -E 's/[A-Za-z0-9_]{30,}/<redacted>/g' | cut -c1-260 | while read -r l; do log "ngrok: $l"; done
    logpos=$size
  fi
  # 3. agent API
  if agent_ok; then agent_bad_since=0; healthy ngrok
  else
    (( agent_bad_since == 0 )) && agent_bad_since=$now
    if (( now - agent_bad_since >= AGENT_GRACE )); then restart_ngrok "agent API has no tunnel for $((now - agent_bad_since))s"; agent_bad_since=$now; fi
  fi
  # 4. local services
  code=$(curl -s -o /dev/null -m 5 -w '%{http_code}' http://127.0.0.1:8000/health); code=${code:-000}
  if [ "$code" = 000 ]; then log "local proxy unreachable"; can_restart proxy && { respawn proxy; log "RESTARTED proxy"; }
  elif [ "$code" != 200 ]; then log "local /health -> $code"; can_restart api && { respawn api; log "RESTARTED api"; }
  else
    healthy proxy; healthy api
    # 5. public check (rationed)
    if (( now - last_public >= PUBLIC_EVERY )) && (( agent_bad_since == 0 )); then
      last_public=$now
      pc=$(curl -s -o /dev/null -m 10 -H 'ngrok-skip-browser-warning: 1' -w '%{http_code}' "$PUBLIC/health"); pc=${pc:-000}
      if [ "$pc" != 200 ]; then log "public /health -> $pc"; restart_ngrok "public check $pc"; last_public=$((now - PUBLIC_EVERY + 20)); fi
    fi
  fi
  sleep "$FAST"
done
